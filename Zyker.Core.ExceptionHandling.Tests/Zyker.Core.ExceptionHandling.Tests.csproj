<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <!-- Enable Microsoft Testing Platform -->
        <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="coverlet.MTP" Version="10.1.0" />
        <PackageReference Include="Microsoft.Testing.Platform" Version="2.5.2" />
        <PackageReference Include="Moq" Version="4.21.0" />
        <PackageReference Include="Shouldly" Version="4.3.0" />
        <PackageReference Include="xunit.v3" Version="4.0.2" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Zyker.Core.ExceptionHandling\Zyker.Core.ExceptionHandling.csproj" />
    </ItemGroup>

</Project>
